# ==========================================
# Stockia WMS · Variables de Entorno de Ejemplo
# ==========================================

# Conexión a Supabase (Obligatorias)
# Obtén estas credenciales en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Pasarela de Pagos Culqi (Opcional - Checkout en Línea y Sandbox)
# Obtén las llaves en: https://panel.culqi.com/desarrollo
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Integraciones B2B API (Opcional - Clave para desarrollo o integración externa)
STOCKIA_DEMO_API_KEY=stk_live_demo_auth_b2b_key_opcional

# Configuración de Servidor
PORT=3000
NODE_ENV=development
